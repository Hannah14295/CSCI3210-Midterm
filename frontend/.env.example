# Vite development proxy destination. Restart Vite after changing.
DJANGO_PROXY_TARGET=http://127.0.0.1:8000

# Leave empty locally to use Vite's proxy. GitHub Actions sets the public Render URL.
VITE_BACKEND_URL=

# GitHub Actions sets /CSCI3210-Midterm/ for Pages. Local development stays at /.
VITE_BASE_PATH=/
