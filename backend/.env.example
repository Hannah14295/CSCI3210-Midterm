# Copy this file to .env. Use your own random secret value in .env.
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Local development can leave these blank. Render must supply both URLs.
DATABASE_URL=
REDIS_URL=

# On Render use only https://hannah14295.github.io (no repository path).
FRONTEND_ORIGINS=https://hannah14295.github.io,http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000

# Optional extra trusted origins for cookie-based Django forms, not token APIs.
DJANGO_CSRF_TRUSTED_ORIGINS=
